# ============================================================
#  Arete — Environment Variables
#  Copy this file to .env.local for local development.
#  In production, set these in Vercel → Settings → Environment Variables.
# ============================================================

# ── Model providers ─────────────────────────────────────────────────────────
# The AI endpoints try these in order (see api/_lib/model.js) and use whichever
# are set, so ONE is enough to run locally. With none set, the AI features
# report themselves as unconfigured rather than breaking.

# Gemini — primary. Most generous free tier; leads the chain for both tiers.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — fast fallback. Also the ONLY provider for Explain-this (api/research.js),
# which needs groq/compound-mini's built-in web search, so leaving this unset
# disables that one feature even when Gemini is configured.
# Get yours free at https://console.groq.com  — no credit card required
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter — last-resort fallback, no SLA. Optional.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# JDoodle Compiler API (Code Playground — "Try It" in each module)
# Sign up free at https://www.jdoodle.com/subscribe-api  (20 runs/day free)
JDOODLE_CLIENT_ID=your_jdoodle_client_id_here
JDOODLE_CLIENT_SECRET=your_jdoodle_client_secret_here

# Supabase (auth + cloud progress sync + AI Tutor personalization)
# Used by both the frontend and the /api/* functions. Values come from
# Supabase → Project Settings → API (or run: node setup-supabase.mjs)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key — SECRET, server-side only, never exposed to the browser.
# Read in exactly one place: api/_lib/serviceRole.js. It bypasses Row Level
# Security, so it is only used where the server must write something the user
# must not be able to forge: the stored Google refresh token (api/google/*) and
# course_materials rows (api/extract.js). Without it, uploads answer 503.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Google OAuth (Calendar sync) ────────────────────────────────────────────
# Separate from Supabase's own Google sign-in — this is a feature-level grant.
# Leave unset to disable "Connect Google"; the Planner degrades gracefully.
# GOOGLE_CLIENT_SECRET also keys the OAuth `state` HMAC — never expose it.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Must match a redirect URI registered on the Google OAuth client exactly.
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback

# Sentry error monitoring (optional — leave unset to disable; the app no-ops).
# Create a free project at https://sentry.io → Settings → Client Keys (DSN).
# VITE_SENTRY_DSN is exposed to the browser (frontend errors); SENTRY_DSN is
# server-side (the /api/* functions). They can be the same project DSN.
VITE_SENTRY_DSN=
SENTRY_DSN=

# Restricts which site's browser may call the /api/* endpoints (CORS).
# Set to your deployed domain to stop other websites embedding your key.
# Leave unset to allow any origin ('*'). NOTE: CORS only blocks browsers —
# for real abuse protection add a rate limiter (e.g. Vercel KV / Upstash).
# Production canonical domain (apex redirects to www on Vercel):
ALLOWED_ORIGIN=https://www.aretecyb.tech
